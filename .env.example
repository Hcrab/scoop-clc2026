# Copy to .env and adjust for an isolated demo database. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scoop

# Portable default: scripted assistant and minimal card-list report.
# For optional live assistance, set gemini and provide the key in the server
# process environment. Never put a key in frontend code.
SCOOP_LLM_PROVIDER=scripted
GEMINI_API_KEY=
SCOOP_GEMINI_MODEL=gemini-3.8-flash

# Portable allowance for the live assistant.
SCOOP_LLM_BUDGET_USD=3
SCOOP_LLM_MAX_CALLS=120
SCOOP_LLM_TIMEOUT_SECONDS=75
